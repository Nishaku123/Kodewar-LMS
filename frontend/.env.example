# Frontend API base URL.
# Leave this unset in development so Vite proxies /api to http://127.0.0.1:5000.
# In production, either serve the SPA from Express (SERVE_FRONTEND=true) or set
# this to the public API origin, for example https://api.example.com/api.
VITE_API_URL=/api

# Optional: change where the Vite dev/preview server forwards /api requests.
# Useful when the backend runs on a different host or port.
# VITE_PROXY_TARGET=http://127.0.0.1:5000
