{
  "name": "kodewar-lms",
  "version": "0.1.0",
  "private": true,
  "description": "Kodewar Technologies Learning Management System (JavaScript only)",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "db:check": "npm run db:check --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "test:api": "npm run test:api --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "ansi-regex": "^6.6.0",
    "ansi-styles": "^6.2.3",
    "chalk": "^5.6.2",
    "cliui": "^9.0.1",
    "emoji-regex": "^10.6.0",
    "escalade": "^3.2.0",
    "get-caller-file": "^2.0.5",
    "get-east-asian-width": "^1.7.0",
    "rxjs": "^7.8.2",
    "shell-quote": "^1.12.0",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.2.0",
    "supports-color": "^10.2.2",
    "tree-kill": "^1.2.2",
    "tslib": "^2.9.1",
    "wrap-ansi": "^9.0.2",
    "y18n": "^5.0.8",
    "yargs": "^18.0.0",
    "yargs-parser": "^22.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
